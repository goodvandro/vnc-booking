# ===========================================
# VNC Booking - Environment Variables
# ===========================================

# Strapi CMS
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
STRAPI_ADMIN_TOKEN=your-strapi-admin-token

# JWT Secret (for admin panel authentication)
JWT_SECRET=your-jwt-secret-change-me-in-production

# Clerk Auth (for public booking site)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
